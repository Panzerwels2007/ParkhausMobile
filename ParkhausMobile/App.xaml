<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ParkhausMobile"
             xmlns:converters="clr-namespace:ParkhausMobile.Converters"
             x:Class="ParkhausMobile.App">
    <Application.Resources>

        <!-- Converter registration for free space status colors in the UI -->
        <ResourceDictionary>
            <ResourceDictionary>
                <converters:FreeSpacesToColorConverter x:Key="FreeSpacesToColorConverter" />
            </ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
