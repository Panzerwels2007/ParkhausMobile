<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkhausMobile.Views.HomePage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            
            <VerticalStackLayout Spacing="6">
                <Label Text="ParkhausMobile"
                       FontSize="30"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label Text="Willkommen zur Übersicht über verfügbare Parkhäuser."
                       FontSize="14"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Opacity="0.8" />
            </VerticalStackLayout>

            
            <Frame HeightRequest="180"
                   CornerRadius="12"
                   BackgroundColor="#E0E0E0"
                   HorizontalOptions="Fill">
                <Label Text="Hier kommt später ein Bild"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Opacity="0.6" />
            </Frame>

            
            <VerticalStackLayout Spacing="4"
                                 VerticalOptions="EndAndExpand">

                <BoxView HeightRequest="1"
                         BackgroundColor="LightGray" />

                <Label Text="Projekt: ParkhausMobile"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Opacity="0.7" />

                <Label Text="IMS Basel – Informatik Mittelschule"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Opacity="0.7" />

                <Label Text="Version 1.0"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Opacity="0.7" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
