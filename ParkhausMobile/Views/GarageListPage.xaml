<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkhausMobile.Views.GarageListPage"
             Title="Parkhäuser">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Parkhaus-Liste"
           FontSize="24"
           FontAttributes="Bold" />

        <SearchBar x:Name="SearchBar"
               Placeholder="Suchen (Name oder Adresse)"
               TextChanged="OnSearchTextChanged" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Picker x:Name="FilterPicker"
                Title="Filter"
                SelectedIndexChanged="OnFilterChanged" />

            <Picker x:Name="SortPicker"
                Grid.Column="1"
                Title="Sortierung"
                SelectedIndexChanged="OnSortChanged" />
        </Grid>

        <CollectionView x:Name="GaragesCollection"
                    SelectionMode="Single"
                    SelectionChanged="OnGarageSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,6" BorderColor="LightGray">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}"
                               FontAttributes="Bold"
                               FontSize="18" />

                            <Label Text="{Binding Address}" />

                            <Label Text="{Binding FreeSpaces, StringFormat='Freie Plätze: {0}'}"
                               TextColor="{Binding FreeSpaces, Converter={StaticResource FreeSpacesToColorConverter}}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>
